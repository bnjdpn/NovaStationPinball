    "workshop.rewind.unlimited" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlimited rewinds. Rewound games stay off the ranked board." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rembobinages illimités. Les parties rembobinées restent hors du classement." } } } },
