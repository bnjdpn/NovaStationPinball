    "workshop.drills.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shot drills" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Atelier de tir" } } } },
    "workshop.drills.untried" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No attempt yet" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune tentative" } } } },
    "workshop.founder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Founder device: you played Nova Station before the Workshop existed, so this game gets ten free rewinds instead of three. The flag lives on this device only and is lost if you reinstall." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Appareil Fondateur : vous jouiez à Nova Station avant l’Atelier, donc cette partie compte dix rembobinages offerts au lieu de trois. Ce statut est enregistré sur cet appareil seulement et disparaît en cas de réinstallation." } } } },
    "workshop.message.no_keyframe" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing has been recorded that far back yet. Play a few seconds and try again." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rien n’a encore été enregistré aussi loin. Jouez quelques secondes puis réessayez." } } } },
    "workshop.open" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Workshop" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Atelier" } } } },
    "workshop.resume" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Take over" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Reprendre ici" } } } },
    "workshop.review.ball" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replay this ball" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revoir cette bille" } } } },
    "workshop.review.five" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replay the last 5 seconds" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revoir les 5 dernières secondes" } } } },
    "workshop.review.hint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replays your own inputs from that point. Take the table back whenever you want." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rejoue vos propres commandes depuis cet instant. Reprenez la table quand vous voulez." } } } },
    "workshop.review.speed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replay speed" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vitesse de lecture" } } } },
    "workshop.review.speed.full" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Normal" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Normal" } } } },
