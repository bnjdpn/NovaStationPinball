    "workshop.rewind.ball_start" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start of ball" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Début de bille" } } } },
    "workshop.rewind.five" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "−5 s" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "−5 s" } } } },
    "workshop.rewind.hint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Puts the ball back where it was and hands the table straight back to you." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Repose la bille où elle était et vous rend la table immédiatement." } } } },
