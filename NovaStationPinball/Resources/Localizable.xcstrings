    "paywall.body" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A one-time purchase that turns Nova Station into a practice table. The table itself, the 17 missions, multiball and the leaderboard stay free." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un achat unique qui transforme Nova Station en table d’entraînement. La table, les 17 missions, le multibille et le classement restent gratuits." } } } },
