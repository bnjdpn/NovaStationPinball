    "status.tilt" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TILT" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "TILT" } } } },
    "workshop.body.free" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Go back a few seconds, watch the ball again, then take over at the exact moment you choose. Three rewinds are included in every game, for good." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revenez quelques secondes en arrière, revoyez la bille, puis reprenez la main à l’instant exact de votre choix. Trois rembobinages sont offerts à chaque partie, pour toujours." } } } },
    "workshop.body.owned" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rewind as often as you want, replay the last five seconds, and drill each shot until it goes in. A rewound game is ranked on the training board only." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rembobinez autant que vous voulez, revoyez les cinq dernières secondes et travaillez chaque tir jusqu’à le sortir. Une partie rembobinée est classée sur le tableau d’entraînement uniquement." } } } },
    "workshop.close" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close the Workshop" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fermer l’Atelier" } } } },
    "workshop.drills.body" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Every attempt serves the ball from the exact same position. Reach the target within 20 seconds without tilting." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chaque tentative sert la bille depuis exactement la même position. Atteignez la cible en 20 secondes sans faire tilt." } } } },
    "workshop.drills.record" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "%1$lld%% success · %#@attempts@ · best streak %3$lld" },
