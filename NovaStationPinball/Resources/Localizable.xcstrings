    "paywall.feature.drills" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "14 shot drills, served from the same position" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "14 exercices de tir, servis depuis la même position" } } } },
    "paywall.feature.review" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replay the last five seconds, at 1× or 0.5×" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revoir les cinq dernières secondes, en 1× ou 0,5×" } } } },
    "paywall.feature.rewind" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlimited rewind: −3 s, −5 s or start of ball" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rembobinage illimité : −3 s, −5 s ou début de bille" } } } },
    "paywall.feature.stats" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Success rate and best streak, kept on this device" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Taux de réussite et meilleure série, sur cet appareil" } } } },
    "paywall.free_forever" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Free forever, purchase or not: the whole table, its 17 missions, the nine promotions, multiball, tilt and the leaderboard. No ads, no tracking, no account." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Gratuit à vie, avec ou sans achat : toute la table, ses 17 missions, les neuf promotions, le multibille, le tilt et le classement. Sans publicité, sans suivi, sans compte." } } } },
    "paywall.link.privacy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Confidentialité" } } } },
    "paywall.link.support" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Support" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Assistance" } } } },
    "paywall.link.terms" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Terms of use" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Conditions d’utilisation" } } } },
    "paywall.loading" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading the offer…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chargement de l’offre…" } } } },
    "paywall.one_time" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One-time purchase, not a subscription: nothing renews and there is nothing to cancel. Works offline, on this Apple Account, and can be restored on your other devices." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Achat unique, pas un abonnement : rien ne se renouvelle et il n’y a rien à résilier. Fonctionne hors ligne, sur ce compte Apple, et restaurable sur vos autres appareils." } } } },
    "paywall.purchase.hint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Buys the Workshop once, with no renewal" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Achète l’Atelier une seule fois, sans renouvellement" } } } },
    "paywall.restore" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore purchase" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Restaurer l’achat" } } } },
    "paywall.status.cancelled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Purchase cancelled. Nothing was charged." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Achat annulé. Rien n’a été débité." } } } },
    "paywall.status.nothing_to_restore" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No previous purchase found on this Apple Account." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun achat précédent trouvé sur ce compte Apple." } } } },
    "paywall.status.owned" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Workshop is unlocked on this device." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’Atelier est débloqué sur cet appareil." } } } },
    "paywall.status.pending" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Purchase awaiting approval." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Achat en attente d’approbation." } } } },
    "paywall.status.unavailable" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The purchase could not be completed." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’achat n’a pas pu aboutir." } } } },
    "paywall.status.unverified" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This purchase could not be verified by the App Store." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cet achat n’a pas pu être vérifié par l’App Store." } } } },
    "paywall.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Workshop" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’Atelier" } } } },
    "paywall.unavailable" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The App Store did not return the offer. Check your connection, then reopen the Workshop. If you already own it, restore your purchase." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’App Store n’a pas renvoyé l’offre. Vérifiez votre connexion puis rouvrez l’Atelier. Si vous l’avez déjà acheté, restaurez votre achat." } } } },
