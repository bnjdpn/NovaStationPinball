    "drill.target-bank" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Target bank" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Banc de cibles" } } } },
    "guide.close" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fermer" } } } },
    "guide.controls.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "1 Left flipper\n2 Right flipper\n3 Pull and release the plunger. Swipe across the table to nudge." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "1 Flipper gauche\n2 Flipper droit\n3 Tirez puis relâchez le lanceur. Balayez le plateau pour le secouer." } } } },
    "guide.controls.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Control the ball" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Contrôler la bille" } } } },
    "guide.missions.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "1 Shoot SELECT to choose\n2 Shoot START to begin\n3 Shoot ACK to clear the result. Then follow the targets shown on the console in order." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "1 Visez SELECT pour choisir\n2 Visez START pour commencer\n3 Visez ACK pour effacer le résultat. Suivez ensuite, dans l’ordre, les cibles indiquées par la console." } } } },
    "guide.missions.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start a mission" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Lancer une mission" } } } },
    "guide.next" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Next" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Suivant" } } } },
    "guide.open" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Guide" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Guide" } } } },
    "guide.previous" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Previous" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Précédent" } } } },
    "guide.progress.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Power up the station, light multiball, and shoot the portal. Completed missions award clearance keys; the console shows live progress." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chargez l’énergie de la station, activez le multibille et traversez le portail. Les missions réussies accordent des clés d’habilitation ; la console affiche la progression en direct." } } } },
    "guide.progress.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlock the station" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Débloquer la station" } } } },
    "guide.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Table guide" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Guide du plateau" } } } },
