    "tips.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tips are optional and repeatable. They unlock no features or gameplay content." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les pourboires sont facultatifs et répétables. Ils ne débloquent aucune fonctionnalité ni aucun contenu de jeu." } } } },
    "tips.close" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close tips" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fermer les pourboires" } } } },
    "tips.loading" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading StoreKit offers…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chargement des offres StoreKit…" } } } },
    "tips.open" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Support" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Soutenir" } } } },
    "tips.outcome.cancelled" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Purchase cancelled. Nothing changed." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Achat annulé. Rien n’a changé." } } } },
    "tips.outcome.pending" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Purchase pending. No feature is locked while you wait." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Achat en attente. Aucune fonctionnalité n’est bloquée pendant ce temps." } } } },
    "tips.outcome.purchased" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Thank you! This tip changes nothing in the game." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Merci ! Ce pourboire ne change rien au jeu." } } } },
    "tips.outcome.unavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The purchase is unavailable. Nothing changed." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’achat est indisponible. Rien n’a changé." } } } },
    "tips.outcome.unverified" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The purchase could not be verified. Nothing changed." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’achat n’a pas pu être vérifié. Rien n’a changé." } } } },
    "tips.purchase.hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Makes an optional, repeatable tip. Unlocks nothing." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Effectue un pourboire facultatif et répétable. Ne débloque rien." } } } },
    "tips.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Optional tips" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pourboires facultatifs" } } } },
    "tips.unavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "StoreKit offers are unavailable right now. The full game remains available." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les offres StoreKit sont indisponibles pour le moment. Le jeu complet reste disponible." } } } },
    "status.system_ready" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "SYSTEM READY" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "SYSTÈME PRÊT" } }
      }
    }
