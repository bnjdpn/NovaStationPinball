    "features": {
      "en": [
        {
          "title": "Two-thumb controls",
          "body": "Use responsive flippers, a pull-and-release plunger and a short nudge gesture with tilt protection."
        },
        {
          "title": "A mission ladder",
          "body": "Climb ramps, open the portal, complete timed missions, earn nine clearance promotions and trigger multiball."
        },
        {
          "title": "One complete table",
          "body": "The full 4:3 playfield and status console stay visible in landscape on iPhone and iPad."
        }
      ],
      "fr": [
        {
          "title": "Commandes à deux pouces",
          "body": "Utilisez des batteurs réactifs, un lanceur à tirer puis relâcher et un geste court pour secouer, avec protection contre le tilt."
        },
        {
          "title": "Une progression par missions",
          "body": "Gravissez les rampes, ouvrez le portail, terminez les missions chronométrées, obtenez neuf habilitations et déclenchez le multibille."
        },
        {
          "title": "Une table complète",
          "body": "Le plateau 4:3 et sa console d’état restent visibles en paysage sur iPhone comme sur iPad."
        }
      ]
    }
  },
